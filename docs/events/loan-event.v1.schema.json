{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lablend:loan-event:v1:provisional",
  "title": "Provisional Borrowing → Notification v1 producer contract; OD-04/05 OPEN",
  "description": "Documents the current producer output. Compatibility is tested; human owner approval and retention agreement remain pending. The consumer currently accepts extra fields and does not validate all producer constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "aggregateId", "correlationId", "occurredAt", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "enum": ["LoanSubmitted", "LoanApproved", "LoanRejected", "LoanHandedOver", "LoanReturned", "LoanDueSoon", "LoanOverdue"] },
    "eventVersion": { "const": 1 },
    "aggregateId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "occurredAt": { "type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$" },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["recipientUserId", "title", "message", "loanId"],
      "properties": {
        "recipientUserId": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "loanId": { "type": "string", "format": "uuid" }
      }
    }
  }
}
