{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "lablend-ai",
    "Audience": "lablend-web"
  },
  "Gemini": {
    "Enabled": false,
    "Model": "gemini-3.5-flash-lite",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 4096
  },
  "Recommendation": { "DailyLimit": 20, "MaxCandidates": 200, "MaxContextBytes": 100000 }
}
