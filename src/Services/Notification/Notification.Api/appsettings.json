{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "lablend-ai",
    "Audience": "lablend-web"
  },
  "NotificationStream": {
    "Stream": "lablend.events.v1",
    "Group": "notification-consumers",
    "ParkingStream": "lablend.events.v1.notification.parking",
    "EventField": "event",
    "BatchSize": 20,
    "MaxAttempts": 5,
    "PendingIdleMilliseconds": 30000,
    "PollDelayMilliseconds": 500
  }
}
