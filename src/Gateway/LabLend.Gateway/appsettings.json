{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "lablend-ai",
    "Audience": "lablend-web"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-api-0": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "AuthorizationPolicy": "Anonymous"
      },
      "identity-api-1": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**remainder}"
        },
        "AuthorizationPolicy": "Default"
      },
      "identity-live": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/platform/identity/health/live"
        },
        "Transforms": [
          {
            "PathSet": "/health/live"
          }
        ],
        "AuthorizationPolicy": "Anonymous"
      },
      "identity-ready": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/platform/identity/health/ready"
        },
        "Transforms": [
          {
            "PathSet": "/health/ready"
          }
        ],
        "AuthorizationPolicy": "Anonymous"
      },
      "identity-openapi": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/platform/identity/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ],
        "AuthorizationPolicy": "Anonymous"
      },
      "catalog-api-0": {
